import 'package:flutter/material.dart';

// ============================================================
// MARKETPLACE DATA MODELS
// ============================================================

enum SellingMode {
  fixed,
  negotiation,
  auction,
}

class Offer {
  final String buyerName;
  double pricePerKg;
  final double quantityKg;
  String status;

  Offer({
    required this.buyerName,
    required this.pricePerKg,
    required this.quantityKg,
    this.status = 'Pending',
  });
}

class ProductListing {
  final String product;
  final double quantityKg;
  final double askingPrice;
  final double minimumPrice;
  final String quality;
  final SellingMode sellingMode;

  String status;
  final List<Offer> offers;

  ProductListing({
    required this.product,
    required this.quantityKg,
    required this.askingPrice,
    required this.minimumPrice,
    required this.quality,
    required this.sellingMode,
    this.status = 'Active',
    List<Offer>? offers,
  }) : offers = offers ?? [];
}

// ============================================================
// MARKETPLACE DATA CONTROLLER
// ============================================================

class MarketplaceController extends ChangeNotifier {
  final List<ProductListing> listings = [];

  MarketplaceController() {
    // Demo listing for testing.
    listings.add(
      ProductListing(
        product: 'Tomatoes',
        quantityKg: 500,
        askingPrice: 30,
        minimumPrice: 27,
        quality: 'Grade A',
        sellingMode: SellingMode.auction,
        offers: [
          Offer(
            buyerName: 'Fresh Mart',
            pricePerKg: 31,
            quantityKg: 200,
          ),
          Offer(
            buyerName: 'Green Basket',
            pricePerKg: 32,
            quantityKg: 300,
          ),
        ],
      ),
    );
  }

  void addListing(ProductListing listing) {
    listings.add(listing);
    notifyListeners();
  }

  void addOffer(
    ProductListing listing,
    Offer offer,
  ) {
    listing.offers.add(offer);
    notifyListeners();
  }

  void acceptOffer(
    ProductListing listing,
    Offer offer,
  ) {
    offer.status = 'Accepted';
    listing.status = 'Sold';

    for (final other in listing.offers) {
      if (other != offer) {
        other.status = 'Rejected';
      }
    }

    notifyListeners();
  }

  void rejectOffer(
    ProductListing listing,
    Offer offer,
  ) {
    offer.status = 'Rejected';
    notifyListeners();
  }

  void counterOffer(
    ProductListing listing,
    Offer offer,
    double price,
  ) {
    offer.pricePerKg = price;
    offer.status = 'Counter Offered';
    notifyListeners();
  }
}

