  // ==========================================================
  // BUYER OFFER DIALOG
  // ==========================================================

  void _offerDialog() {

    final priceController =
        TextEditingController();

    final quantityController =
        TextEditingController(
      text: widget.listing.quantityKg
          .toStringAsFixed(0),
    );

    showDialog(
      context: context,

      builder: (dialogContext) {

        return AlertDialog(

          title: Text(
            widget.listing.sellingMode ==
                    SellingMode.auction
                ? 'Place Your Bid'
                : 'Make Your Offer',
          ),

          content: Column(
            mainAxisSize:
                MainAxisSize.min,

            children: [

              TextField(
                controller:
                    priceController,

                keyboardType:
                    const TextInputType
                        .numberWithOptions(
                  decimal: true,
                ),

                decoration:
                    const InputDecoration(
                  labelText:
                      'Price per kg',
                  prefixText: '₹ ',
                ),
              ),

              const SizedBox(height: 12),

              TextField(
                controller:
                    quantityController,

                keyboardType:
                    const TextInputType
                        .numberWithOptions(
                  decimal: true,
                ),

                decoration:
                    const InputDecoration(
                  labelText:
                      'Quantity (kg)',
                ),
              ),
            ],
          ),

          actions: [

            TextButton(
              onPressed: () {
                Navigator.pop(
                  dialogContext,
                );
              },

              child:
                  const Text('Cancel'),
            ),

            ElevatedButton(
              onPressed: () {

                final price =
                    double.tryParse(
                  priceController.text,
                );

                final quantity =
                    double.tryParse(
                  quantityController.text,
                );

                if (price == null ||
                    quantity == null ||
                    price <= 0 ||
                    quantity <= 0) {
                  return;
                }

                widget.controller.addOffer(

                  widget.listing,

                  Offer(
                    buyerName:
                        'Demo Buyer',
                    pricePerKg:
                        price,
                    quantityKg:
                        quantity,
                  ),
                );

                Navigator.pop(
                  dialogContext,
                );

                _message(
                  'Your offer has been submitted!',
                );
              },

              child:
                  const Text('SUBMIT'),
            ),
          ],
        );
      },
    );
  }

  // ==========================================================
  // COUNTER OFFER
  // ==========================================================

  void _counterDialog(
    Offer offer,
  ) {

    final controller =
        TextEditingController(
      text:
          offer.pricePerKg
              .toStringAsFixed(0),
    );

    showDialog(
      context: context,

      builder: (dialogContext) {

        return AlertDialog(

          title:
              const Text('Counter Offer'),

          content: TextField(
            controller: controller,

            keyboardType:
                const TextInputType
                    .numberWithOptions(
              decimal: true,
            ),

            decoration:
                const InputDecoration(
              labelText:
                  'Your counter price',
              prefixText: '₹ ',
            ),
          ),

          actions: [

            TextButton(
              onPressed: () {
                Navigator.pop(
                  dialogContext,
                );
              },

              child:
                  const Text('Cancel'),
            ),

            ElevatedButton(
              onPressed: () {

                final price =
                    double.tryParse(
                  controller.text,
                );

                if (price == null ||
                    price <= 0) {
                  return;
                }

                widget.controller
                    .counterOffer(
                  widget.listing,
                  offer,
                  price,
                );

                Navigator.pop(
                  dialogContext,
                );

                _message(
                  'Counter offer sent!',
                );
              },

              child:
                  const Text('SEND'),
            ),
          ],
        );
      },
    );
  }

  void _message(String text) {
    ScaffoldMessenger.of(context)
        .showSnackBar(
      SnackBar(
        content: Text(text),
      ),
    );
  }
