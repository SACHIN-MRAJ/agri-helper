class CreateListingScreen extends StatefulWidget {
  final MarketplaceController controller;

  const CreateListingScreen({
    super.key,
    required this.controller,
  });

  @override
  State<CreateListingScreen> createState() =>
      _CreateListingScreenState();
}

class _CreateListingScreenState
    extends State<CreateListingScreen> {

  final productController =
      TextEditingController();

  final quantityController =
      TextEditingController();

  final priceController =
      TextEditingController();

  final minimumController =
      TextEditingController();

  final qualityController =
      TextEditingController(
    text: 'Grade A',
  );

  SellingMode selectedMode =
      SellingMode.auction;

  @override
  void dispose() {
    productController.dispose();
    quantityController.dispose();
    priceController.dispose();
    minimumController.dispose();
    qualityController.dispose();

    super.dispose();
  }

  void createListing() {

    final product =
        productController.text.trim();

    final quantity =
        double.tryParse(
      quantityController.text,
    );

    final price =
        double.tryParse(
      priceController.text,
    );

    final minimum =
        double.tryParse(
      minimumController.text,
    );

    if (product.isEmpty ||
        quantity == null ||
        price == null ||
        minimum == null ||
        quantity <= 0 ||
        price <= 0 ||
        minimum <= 0) {

      _showMessage(
        'Please enter valid details.',
      );

      return;
    }

    if (minimum > price) {
      _showMessage(
        'Minimum price cannot exceed asking price.',
      );

      return;
    }

    widget.controller.addListing(
      ProductListing(
        product: product,
        quantityKg: quantity,
        askingPrice: price,
        minimumPrice: minimum,
        quality:
            qualityController.text.trim().isEmpty
                ? 'Standard'
                : qualityController.text.trim(),
        sellingMode: selectedMode,
      ),
    );

    Navigator.pop(context);

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text(
          'Your produce has been listed successfully!',
        ),
      ),
    );
  }

  void _showMessage(String message) {
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(message),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.grey.shade50,

      appBar: AppBar(
        title: const Text(
          'Create Listing',
        ),
      ),

      body: ListView(
        padding: const EdgeInsets.all(18),

        children: [

          const Text(
            'List Your Produce',
            style: TextStyle(
              fontSize: 24,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 5),

          Text(
            'Set your price and choose how you want to sell.',
            style: TextStyle(
              color: Colors.grey.shade600,
            ),
          ),

          const SizedBox(height: 22),

          _field(
            controller: productController,
            label: 'Product',
            hint: 'Example: Tomato',
            icon: Icons.eco,
          ),

          const SizedBox(height: 14),

          _field(
            controller: quantityController,
            label: 'Quantity (kg)',
            hint: 'Example: 500',
            icon: Icons.scale,
            number: true,
          ),

          const SizedBox(height: 14),

          _field(
            controller: priceController,
            label: 'Asking Price (₹/kg)',
            hint: 'Example: 30',
            icon: Icons.currency_rupee,
            number: true,
          ),

          const SizedBox(height: 14),

          _field(
            controller: minimumController,
            label: 'Minimum Acceptable Price (₹/kg)',
            hint: 'Example: 27',
            icon: Icons.price_check,
            number: true,
          ),

          const SizedBox(height: 14),

          _field(
            controller: qualityController,
            label: 'Quality / Grade',
            hint: 'Example: Grade A',
            icon: Icons.star,
          ),

          const SizedBox(height: 25),

          const Text(
            'Selling Method',
            style: TextStyle(
              fontSize: 18,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 10),

          _sellingOption(
            SellingMode.fixed,
            Icons.sell,
            'Fixed Price',
            'Sell at the price you set.',
          ),

          _sellingOption(
            SellingMode.negotiation,
            Icons.handshake,
            'Negotiation',
            'Allow buyers to negotiate.',
          ),

          _sellingOption(
            SellingMode.auction,
            Icons.gavel,
            'Auction',
            'Let multiple buyers compete.',
          ),

          const SizedBox(height: 20),

          SizedBox(
            width: double.infinity,

            child: ElevatedButton.icon(
              onPressed: createListing,

              icon: Icon(
                selectedMode ==
                        SellingMode.auction
                    ? Icons.gavel
                    : Icons.check_circle,
              ),

              label: Text(
                selectedMode ==
                        SellingMode.auction
                    ? 'CREATE AUCTION'
                    : 'CREATE LISTING',
              ),

              style: ElevatedButton.styleFrom(
                padding:
                    const EdgeInsets.symmetric(
                  vertical: 15,
                ),
              ),
            ),
          ),

          const SizedBox(height: 20),
        ],
      ),
    );
  }

  Widget _field({
    required TextEditingController controller,
    required String label,
    required String hint,
    required IconData icon,
    bool number = false,
  }) {
    return TextField(
      controller: controller,

      keyboardType: number
          ? const TextInputType.numberWithOptions(
              decimal: true,
            )
          : TextInputType.text,

      decoration: InputDecoration(
        labelText: label,
        hintText: hint,
        prefixIcon: Icon(icon),
        filled: true,
        fillColor: Colors.white,

        border: OutlineInputBorder(
          borderRadius:
              BorderRadius.circular(13),
          borderSide: BorderSide.none,
        ),

        enabledBorder: OutlineInputBorder(
          borderRadius:
              BorderRadius.circular(13),
          borderSide: BorderSide(
            color: Colors.grey.shade300,
          ),
        ),

        focusedBorder: OutlineInputBorder(
          borderRadius:
              BorderRadius.circular(13),
          borderSide: const BorderSide(
            color: Color(0xFF2E7D32),
            width: 2,
          ),
        ),
      ),
    );
  }

  Widget _sellingOption(
    SellingMode mode,
    IconData icon,
    String title,
    String subtitle,
  ) {
    final selected =
        selectedMode == mode;

    return GestureDetector(
      onTap: () {
        setState(() {
          selectedMode = mode;
        });
      },

      child: Container(
        margin:
            const EdgeInsets.only(bottom: 10),

        padding:
            const EdgeInsets.all(14),

        decoration: BoxDecoration(
          color: selected
              ? const Color(0xFFE8F5E9)
              : Colors.white,

          borderRadius:
              BorderRadius.circular(14),

          border: Border.all(
            color: selected
                ? const Color(0xFF2E7D32)
                : Colors.grey.shade300,

            width: selected ? 2 : 1,
          ),
        ),

        child: Row(
          children: [

            Icon(
              icon,
              color: const Color(0xFF2E7D32),
            ),

            const SizedBox(width: 12),

            Expanded(
              child: Column(
                crossAxisAlignment:
                    CrossAxisAlignment.start,

                children: [

                  Text(
                    title,
                    style: const TextStyle(
                      fontWeight: FontWeight.bold,
                    ),
                  ),

                  const SizedBox(height: 3),

                  Text(
                    subtitle,
                    style: TextStyle(
                      color:
                          Colors.grey.shade600,
                      fontSize: 12,
                    ),
                  ),
                ],
              ),
            ),

            Icon(
              selected
                  ? Icons.radio_button_checked
                  : Icons.radio_button_off,

              color: selected
                  ? const Color(0xFF2E7D32)
                  : Colors.grey,
            ),
          ],
        ),
      ),
    );
  }
}

